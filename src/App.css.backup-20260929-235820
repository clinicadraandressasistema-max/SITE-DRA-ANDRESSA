@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;1,500&display=swap");


@scope (#dallarmi-public-home) {



:scope {
  --wine: #76151c;
  --wine-dark: #5b0e15;
  --gold: #c6a15b;
  --cream: #faf7f4;
  --cream-2: #f4efeb;
  --ink: #282322;
  --muted: #706866;
  --line: #ece3df;
  --white: #ffffff;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  overflow-x: hidden;
}

body {
  margin: 0;
  min-width: 320px;
  color: var(--ink);
  background: var(--white);
  font-family: "DM Sans", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

button,
a {
  font: inherit;
}

button {
  border: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  display: block;
  max-width: 100%;
}

.container {
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto;
}

/* HEADER */

.header {
  position: sticky;
  z-index: 100;
  top: 0;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid rgba(118, 21, 28, 0.07);
  backdrop-filter: blur(16px);
}

.header-inner {
  height: 84px;
  display: flex;
  align-items: center;
  gap: 34px;
}

.brand {
  width: 190px;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  color: var(--wine);
}

.brand strong {
  font-family: "Playfair Display", Georgia, serif;
  font-size: 25px;
  font-weight: 500;
  letter-spacing: 0.02em;
  line-height: 1;
}

.brand span {
  margin-top: 6px;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.nav {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 25px;
}

.nav a {
  position: relative;
  padding: 32px 0;
  color: #514b49;
  font-size: 11px;
  font-weight: 600;
  white-space: nowrap;
}

.nav a::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 21px;
  left: 0;
  height: 1px;
  background: var(--wine);
  transform: scaleX(0);
  transition: transform 0.25s ease;
}

.nav a:hover {
  color: var(--wine);
}

.nav a:hover::after {
  transform: scaleX(1);
}

.header-book {
  flex-shrink: 0;
  min-height: 44px;
  padding: 0 21px;
  color: white;
  background: var(--wine);
  border-radius: 8px;
  cursor: pointer;
  font-size: 11px;
  font-weight: 700;
  transition: 0.25s ease;
}

.header-book:hover {
  background: var(--wine-dark);
  transform: translateY(-1px);
}

.menu-button {
  display: none;
  width: 42px;
  height: 42px;
  margin-left: auto;
  padding: 0;
  background: transparent;
}

.menu-button span {
  width: 22px;
  height: 1px;
  display: block;
  margin: 6px auto;
  background: var(--wine);
}

/* GLOBAL */

.overline {
  margin: 0 0 19px;
  color: var(--wine);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.32em;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1,
h2 {
  font-family: "Playfair Display", Georgia, serif;
  font-weight: 500;
}

h1 em,
h2 em {
  color: var(--wine);
  font-weight: 500;
}

.btn {
  min-height: 49px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  padding: 0 22px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 11px;
  font-weight: 700;
  transition: 0.25s ease;
}

.btn:hover {
  transform: translateY(-2px);
}

.btn-wine {
  color: white;
  background: var(--wine);
}

.btn-wine:hover {
  background: var(--wine-dark);
}

.btn-light {
  color: var(--wine);
  background: white;
  border: 1px solid rgba(118, 21, 28, 0.3);
}

/* HERO */

.hero {
  background: white;
}

.hero-grid {
  min-height: 660px;
  display: grid;
  grid-template-columns: 0.94fr 1.06fr;
  align-items: center;
  gap: 70px;
  padding-top: 45px;
  padding-bottom: 45px;
}

.hero-copy {
  padding-left: 12px;
}

.hero h1 {
  max-width: 600px;
  margin-bottom: 25px;
  color: #292321;
  font-size: clamp(50px, 5vw, 72px);
  line-height: 0.99;
  letter-spacing: -0.035em;
}

.hero-text {
  max-width: 530px;
  margin-bottom: 30px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.8;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 11px;
}

.hero-features {
  display: flex;
  gap: 31px;
  margin-top: 45px;
  padding-top: 25px;
  border-top: 1px solid var(--line);
}

.hero-features > div {
  display: flex;
  align-items: center;
  gap: 10px;
}

.feature-icon {
  width: 34px;
  height: 34px;
  display: grid;
  flex: 0 0 34px;
  place-items: center;
  color: var(--gold);
  border: 1px solid rgba(198, 161, 91, 0.55);
  border-radius: 50%;
  font-size: 8px;
  font-weight: 700;
}

.hero-features p {
  margin: 0;
  color: #655e5b;
  font-size: 9px;
  line-height: 1.45;
}

.hero-features strong {
  color: #38312f;
  font-weight: 600;
}

.hero-photo {
  position: relative;
  height: 570px;
}

.hero-photo::before {
  content: "";
  position: absolute;
  z-index: 2;
  top: -35px;
  left: -38px;
  width: 270px;
  height: 450px;
  border: 1px solid var(--gold);
  border-right-color: transparent;
  border-bottom-color: transparent;
  border-radius: 55% 45% 0 0;
  transform: rotate(11deg);
  pointer-events: none;
}

.hero-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  border-radius: 150px 4px 4px 4px;
}

.hero-signature {
  position: absolute;
  right: 24px;
  bottom: 24px;
  min-width: 190px;
  padding: 15px 20px;
  text-align: right;
  background: rgba(255, 255, 255, 0.93);
  border-radius: 7px;
  backdrop-filter: blur(8px);
}

.hero-signature small {
  display: block;
  color: #866f69;
  font-size: 6px;
  font-weight: 700;
  letter-spacing: 0.17em;
}

.hero-signature strong {
  display: block;
  margin-top: 3px;
  color: var(--wine);
  font-family: "Playfair Display", Georgia, serif;
  font-size: 23px;
  font-weight: 500;
}

/* INTRO */

.intro {
  padding: 100px 0;
  border-top: 1px solid var(--line);
}

.intro-grid {
  display: grid;
  grid-template-columns: 1fr 0.78fr;
  align-items: end;
  gap: 90px;
}

.intro h2,
.section-top h2,
.hair h2,
.doctor h2,
.attendance h2,
.final-cta h2 {
  margin: 0;
  color: #2a2422;
  font-size: clamp(38px, 4vw, 56px);
  line-height: 1.06;
  letter-spacing: -0.025em;
}

.intro-copy p {
  margin-bottom: 22px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.8;
}

.intro-copy a,
.simple-link {
  color: var(--wine);
  font-size: 11px;
  font-weight: 700;
}

.intro-copy a span,
.simple-link span {
  margin-left: 8px;
}

/* SPECIALTIES */

.specialties {
  padding: 100px 0 105px;
  background: var(--cream);
}

.section-top {
  display: grid;
  grid-template-columns: 1.2fr 0.65fr;
  align-items: end;
  gap: 70px;
  margin-bottom: 45px;
}

.section-top > p {
  margin: 0 0 5px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
}

.specialty-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.specialty-card {
  overflow: hidden;
  background: white;
  border: 1px solid #ebe1dc;
  border-radius: 14px;
  transition: 0.25s ease;
}

.specialty-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 45px rgba(67, 37, 33, 0.08);
}

.specialty-image {
  height: 220px;
  overflow: hidden;
  background: #eee7e3;
}

.specialty-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.specialty-card:hover .specialty-image img {
  transform: scale(1.035);
}

.specialty-body {
  position: relative;
  min-height: 205px;
  padding: 27px 24px 24px;
}

.specialty-mark {
  position: absolute;
  top: -18px;
  left: 22px;
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  color: var(--wine);
  background: white;
  border: 1px solid #eee3de;
  border-radius: 50%;
  font-family: "Playfair Display", serif;
  font-size: 19px;
}

.specialty-body h3 {
  margin: 7px 0 11px;
  color: #342d2b;
  font-family: "Playfair Display", Georgia, serif;
  font-size: 20px;
  font-weight: 500;
  line-height: 1.15;
}

.specialty-body p {
  min-height: 55px;
  margin-bottom: 17px;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.7;
}

.specialty-body a {
  color: var(--wine);
  font-size: 10px;
  font-weight: 700;
}

.specialty-body a span {
  margin-left: 7px;
}

.specialty-bottom {
  display: flex;
  justify-content: flex-end;
  margin-top: 28px;
}

/* HAIR */

.hair {
  padding: 110px 0;
}

.hair-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  align-items: center;
  gap: 85px;
}

.hair-copy > p:not(.overline) {
  max-width: 510px;
  margin: 24px 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.8;
}

.hair-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 29px;
}

.hair-list span {
  padding: 8px 11px;
  color: var(--wine);
  background: #faf5f2;
  border: 1px solid #eaded8;
  border-radius: 50px;
  font-size: 9px;
  font-weight: 600;
}

.hair-photo {
  position: relative;
  height: 525px;
}

.hair-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 5px 130px 5px 5px;
}

.hair-circle {
  position: absolute;
  right: -60px;
  bottom: -70px;
  width: 240px;
  height: 240px;
  border: 1px solid var(--gold);
  border-radius: 50%;
  pointer-events: none;
}

/* DOCTOR */

.doctor {
  padding: 110px 0;
  background: var(--cream);
}

.doctor-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  align-items: center;
  gap: 85px;
}

.doctor-photo {
  height: 600px;
  overflow: hidden;
  border-radius: 5px 125px 5px 5px;
  background: var(--cream-2);
}

.doctor-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
}

.doctor-copy > p:not(.overline):not(.doctor-role) {
  max-width: 590px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.8;
}

.doctor-role {
  margin: 22px 0;
  color: var(--wine);
  font-size: 11px;
  font-weight: 700;
  line-height: 1.6;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.doctor-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 11px;
  margin-top: 31px;
}

/* PILLARS */

.pillars {
  padding: 32px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.pillars-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.pillars-grid > div {
  min-height: 135px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px;
  text-align: center;
  border-right: 1px solid var(--line);
}

.pillars-grid > div:last-child {
  border-right: 0;
}

.pillars-grid span {
  margin-bottom: 10px;
  color: var(--gold);
  font-family: "Playfair Display", Georgia, serif;
  font-size: 13px;
}

.pillars-grid strong {
  color: #352f2d;
  font-family: "Playfair Display", Georgia, serif;
  font-size: 15px;
  font-weight: 500;
}

.pillars-grid p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 9px;
}

/* ATTENDANCE */

.attendance {
  padding: 105px 0;
}

.attendance-grid {
  display: grid;
  grid-template-columns: 1fr 0.8fr;
  align-items: center;
  gap: 80px;
}

.attendance-main {
  padding: 42px;
  color: white;
  background: var(--wine);
  border-radius: 11px;
}

.attendance-main > span {
  color: #e4c891;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.22em;
}

.attendance-main h3 {
  margin: 11px 0 7px;
  font-family: "Playfair Display", Georgia, serif;
  font-size: 34px;
  font-weight: 500;
}

.attendance-main p {
  margin-bottom: 24px;
  color: rgba(255, 255, 255, 0.72);
  font-size: 11px;
}

.attendance-main .btn {
  color: var(--wine);
  background: white;
}

.insurance-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  margin-top: 25px;
  padding: 25px 30px;
  background: var(--cream);
  border: 1px solid var(--line);
  border-radius: 9px;
}

.insurance-empty strong {
  display: block;
  margin-bottom: 5px;
  font-family: "Playfair Display", Georgia, serif;
  font-size: 16px;
  font-weight: 500;
}

.insurance-empty p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
}

.insurance-empty > span {
  flex-shrink: 0;
  color: var(--wine);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* FINAL CTA */

.final-cta {
  padding: 20px 0 105px;
}

.final-box {
  position: relative;
  overflow: hidden;
  min-height: 385px;
  display: grid;
  grid-template-columns: 1fr 0.65fr;
  align-items: center;
  padding: 70px;
  background: var(--cream);
  border-radius: 13px;
}

.final-box > div:first-child {
  position: relative;
  z-index: 2;
}

.final-box p:not(.overline) {
  max-width: 500px;
  margin: 20px 0 27px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
}

.final-detail {
  position: relative;
  height: 100%;
  display: grid;
  place-items: center;
}

.final-detail span {
  color: rgba(118, 21, 28, 0.12);
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(55px, 7vw, 100px);
}

.final-line {
  position: absolute;
  width: 300px;
  height: 300px;
  border: 1px solid var(--gold);
  border-radius: 50%;
}

/* FOOTER */

.footer {
  padding: 65px 0 22px;
  background: white;
  border-top: 1px solid var(--line);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.6fr repeat(3, 1fr);
  gap: 45px;
}

.footer-brand {
  display: flex;
  flex-direction: column;
}

.footer-brand strong {
  color: var(--wine);
  font-family: "Playfair Display", Georgia, serif;
  font-size: 27px;
  font-weight: 500;
}

.footer-brand > span {
  margin-top: 6px;
  color: #866f69;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.footer-brand p {
  max-width: 270px;
  margin-top: 19px;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.7;
}

.footer-links {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
}

.footer-links > strong {
  margin-bottom: 6px;
  color: var(--wine);
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.footer-links a,
.footer-links span,
.footer-links button {
  padding: 0;
  color: var(--muted);
  background: transparent;
  cursor: pointer;
  font-size: 9px;
  text-align: left;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 45px;
  padding-top: 20px;
  color: #918784;
  border-top: 1px solid var(--line);
  font-size: 7px;
  letter-spacing: 0.06em;
}

/* MODAL */

.modal-bg {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(38, 26, 24, 0.62);
  backdrop-filter: blur(8px);
}

.modal {
  position: relative;
  width: min(500px, 100%);
  padding: 40px;
  background: white;
  border-radius: 14px;
  box-shadow: 0 30px 80px rgba(42, 24, 21, 0.22);
}

.modal h2 {
  margin-bottom: 11px;
  color: #302927;
  font-size: 34px;
}

.modal > p:not(.overline) {
  margin-bottom: 25px;
  color: var(--muted);
  font-size: 11px;
}

.modal-close {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 36px;
  height: 36px;
  color: var(--wine);
  background: var(--cream);
  border-radius: 50%;
  cursor: pointer;
  font-size: 20px;
}

.booking-option {
  width: 100%;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 15px;
  margin-top: 10px;
  padding: 18px;
  color: var(--ink);
  text-align: left;
  background: white;
  border: 1px solid var(--line);
  border-radius: 9px;
  cursor: pointer;
  transition: 0.2s ease;
}

.booking-option:hover {
  border-color: rgba(118, 21, 28, 0.45);
}

.booking-option > span {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  color: var(--wine);
  background: var(--cream);
  border-radius: 50%;
  font-size: 8px;
  font-weight: 700;
}

.booking-option div {
  display: flex;
  flex-direction: column;
}

.booking-option strong {
  color: var(--wine);
  font-size: 11px;
}

.booking-option small {
  margin-top: 4px;
  color: var(--muted);
  font-size: 9px;
}

.booking-option b {
  color: var(--wine);
}

/* RESPONSIVO */

@media (max-width: 1080px) {
  .nav {
    position: absolute;
    top: 74px;
    right: 24px;
    left: 24px;
    display: none;
    padding: 12px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 22px 50px rgba(45, 28, 25, 0.12);
  }

  .nav-open {
    display: grid;
  }

  .nav a {
    padding: 12px;
  }

  .nav a::after {
    display: none;
  }

  .menu-button {
    display: block;
  }

  .header-book {
    margin-left: auto;
  }

  .specialty-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 850px) {
  .container {
    width: min(100% - 32px, 700px);
  }

  .header-book {
    display: none;
  }

  .hero-grid,
  .intro-grid,
  .section-top,
  .hair-grid,
  .doctor-grid,
  .attendance-grid {
    grid-template-columns: 1fr;
  }

  .hero-grid {
    gap: 45px;
    padding-top: 65px;
  }

  .hero-copy {
    padding-left: 0;
  }

  .hero-photo {
    height: 580px;
  }

  .intro-grid,
  .section-top,
  .hair-grid,
  .doctor-grid,
  .attendance-grid {
    gap: 40px;
  }

  .hero-features {
    justify-content: space-between;
  }

  .pillars-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .pillars-grid > div:nth-child(2) {
    border-right: 0;
  }

  .pillars-grid > div:nth-child(-n + 2) {
    border-bottom: 1px solid var(--line);
  }

  .final-box {
    grid-template-columns: 1fr;
    padding: 55px;
  }

  .final-detail {
    display: none;
  }

  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 560px) {
  .container {
    width: calc(100% - 28px);
  }

  .header-inner {
    height: 72px;
  }

  .brand {
    width: auto;
  }

  .brand strong {
    font-size: 21px;
  }

  .brand span {
    font-size: 6px;
  }

  .nav {
    top: 70px;
    right: 14px;
    left: 14px;
  }

  .hero-grid {
    padding-top: 48px;
  }

  .hero h1 {
    font-size: 45px;
  }

  .hero-buttons {
    display: grid;
  }

  .hero-buttons .btn {
    width: 100%;
  }

  .hero-features {
    display: grid;
    gap: 15px;
  }

  .hero-photo {
    height: 455px;
  }

  .hero-photo img {
    border-radius: 95px 4px 4px 4px;
  }

  .hero-photo::before {
    width: 200px;
    height: 340px;
  }

  .intro,
  .specialties,
  .hair,
  .doctor,
  .attendance {
    padding: 75px 0;
  }

  .intro h2,
  .section-top h2,
  .hair h2,
  .doctor h2,
  .attendance h2,
  .final-cta h2 {
    font-size: 39px;
  }

  .specialty-grid {
    grid-template-columns: 1fr;
  }

  .specialty-image {
    height: 250px;
  }

  .hair-photo {
    height: 430px;
  }

  .doctor-photo {
    height: 500px;
  }

  .doctor-actions {
    display: grid;
  }

  .doctor-actions .btn {
    width: 100%;
  }

  .pillars-grid {
    grid-template-columns: 1fr;
  }

  .pillars-grid > div {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .pillars-grid > div:last-child {
    border-bottom: 0;
  }

  .insurance-empty {
    align-items: flex-start;
    flex-direction: column;
  }

  .final-box {
    padding: 40px 25px;
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }

  .footer-bottom {
    flex-direction: column;
  }

  .modal {
    padding: 35px 20px 22px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition: none !important;
  }
}

}